    ];

    const INITIAL_ACTIVITY = [
      { id: "act1", actor: "principal@geca", action: "updated cabin status", detail: "In cabin — free", created_at: new Date(Date.now() - 3600000).toISOString() },
      { id: "act2", actor: "principal@geca", action: "posted a notice", detail: "Urgent Meeting: NAAC Accreditation Review", created_at: new Date(Date.now() - 7200000).toISOString() }
