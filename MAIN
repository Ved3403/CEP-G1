      { id: "m3", sender: "tpo@geca", recipient: "principal@geca", body: "Respected Principal Sir, campus placement drive for TCS starts tomorrow at 9 AM.", urgent: false, created_at: new Date(Date.now() - 1800000).toISOString(), read_at: null }
