    };

    const INITIAL_STAFF = [
      { id: "principal@geca", name: "Dr. S. K. Mahajan", role: "Principal", dept: "Administration", grp: "leadership", cabin: true, group_member: true, is_admin: true, password: "123" },
      { id: "deanacad@geca", name: "Dr. A. B. Thorat", role: "Dean (Academics)", dept: "Academic Section", grp: "leadership", cabin: true, group_member: true, is_admin: false, password: "123" },
      { id: "deanrd@geca", name: "Dr. P. R. Deshmukh", role: "Dean (R&D)", dept: "Research & Development", grp: "leadership", cabin: true, group_member: true, is_admin: false, password: "123" },
      { id: "registrar@geca", name: "Prof. M. V. Patil", role: "Registrar", dept: "Main Office", grp: "leadership", cabin: true, group_member: true, is_admin: false, password: "123" },
      { id: "hodcivil@geca", name: "Dr. R. S. Gaikwad", role: "HoD Civil Engg", dept: "Civil Engineering", grp: "department", cabin: true, group_member: true, is_admin: false, password: "123" },
      { id: "hodmech@geca", name: "Dr. V. K. Kulkarni", role: "HoD Mechanical Engg", dept: "Mechanical Engineering", grp: "department", cabin: true, group_member: true, is_admin: false, password: "123" },
      { id: "hodelec@geca", name: "Dr. S. N. Joshi", role: "HoD Electrical Engg", dept: "Electrical Engineering", grp: "department", cabin: true, group_member: true, is_admin: false, password: "123" },
      { id: "hodcse@geca", name: "Dr. U. V. Kulkarni", role: "HoD Computer Science", dept: "CSE Department", grp: "department", cabin: true, group_member: true, is_admin: false, password: "123" },
      { id: "tpo@geca", name: "Prof. G. R. More", role: "Training & Placement Officer", dept: "T&P Cell", grp: "support", cabin: true, group_member: false, is_admin: false, password: "123" },
      { id: "librarian@geca", name: "Ms. S. P. Shinde", role: "Chief Librarian", dept: "Central Library", grp: "support", cabin: true, group_member: false, is_admin: false, password: "123" }
    ];

    const INITIAL_CABIN = {
      "principal@geca": { status: "free", note: "Available for urgent queries", back_at: "" },
      "deanacad@geca": { status: "busy", note: "Curriculum meeting in progress", back_at: "3:30 PM" },
      "hodcse@geca": { status: "free", note: "In office", back_at: "" },
      "hodcivil@geca": { status: "out", note: "On site inspection", back_at: "4:00 PM" }
    };

    const INITIAL_MESSAGES = [
      { id: "m1", sender: "principal@geca", recipient: "grp-deanshods", body: "Good morning Deans & HoDs. Please submit the Q3 academic review reports by 4 PM today.", urgent: true, created_at: new Date(Date.now() - 3600000 * 2).toISOString(), read_at: new Date().toISOString() },
      { id: "m2", sender: "deanacad@geca", recipient: "grp-deanshods", body: "Received Sir. Academic section reports are consolidated.", urgent: false, created_at: new Date(Date.now() - 3600000).toISOString(), read_at: new Date().toISOString() },
      { id: "m3", sender: "tpo@geca", recipient: "principal@geca", body: "Respected Principal Sir, campus placement drive for TCS starts tomorrow at 9 AM.", urgent: false, created_at: new Date(Date.now() - 1800000).toISOString(), read_at: null }
    ];

    const INITIAL_NOTICES = [
      { id: "n1", author: "principal@geca", title: "Urgent Meeting: NAAC Accreditation Review", body: "All Deans and Department Heads are requested to assemble in Conference Room 1 today at 3:30 PM sharp.", category: "Meeting", urgent: true, pinned: true, created_at: new Date(Date.now() - 7200000).toISOString() },
      { id: "n2", author: "deanacad@geca", title: "End-Semester Examination Schedule Published", body: "The tentative timetable for November end-sem exams is posted on the notice board. Kindly submit grievances by Friday.", category: "Examinations", urgent: false, pinned: false, created_at: new Date(Date.now() - 14400000).toISOString() }
    ];

    const INITIAL_APPOINTMENTS = [
      { id: "a1", requester: "hodcse@geca", target: "principal@geca", purpose: "Approval for new AI/ML Lab workstation procurement", slot: "Tomorrow at 11:30 AM", status: "pending", created_at: new Date(Date.now() - 5400000).toISOString() }
    ];

    const INITIAL_ACTIVITY = [
      { id: "act1", actor: "principal@geca", action: "updated cabin status", detail: "In cabin — free", created_at: new Date(Date.now() - 3600000).toISOString() },
      { id: "act2", actor: "principal@geca", action: "posted a notice", detail: "Urgent Meeting: NAAC Accreditation Review", created_at: new Date(Date.now() - 7200000).toISOString() }
    ];

    // --- HELPER UTILITIES ---
    function getLampClass(status) {
      if (status === "free") return "lamp lamp-free";
      if (status === "busy") return "lamp lamp-busy";
      return "lamp lamp-out";
    }

    function getGroupBadgeBg(grp) {
      if (grp === "leadership") return "bg-brass text-white";
      if (grp === "department") return "bg-sage text-paper-3";
      if (grp === "group") return "bg-brick text-paper-3";
      return "bg-steel text-paper-3";
    }

    function getInitials(name) {
      return name
        ? name.replace(/^(Dr\.|Mr\.|Mrs\.|Ms\.|Prof\.)\s*/, "").trim().split(" ").filter(Boolean).slice(0, 2).map(n => n[0]).join("").toUpperCase()
        : "?";
    }

    function formatTime(isoString) {
      return new Date(isoString).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    }

    function formatDateLabel(isoString) {
      const d = new Date(isoString);
      const today = new Date();
      return d.toDateString() === today.toDateString() ? "Today" : d.toLocaleDateString([], { day: "numeric", month: "short" });
    }

    function formatTimeAgo(isoString) {
      const diff = Date.now() - new Date(isoString).getTime();
      const mins = Math.round(diff / 60000);
      if (mins < 1) return "just now";
      if (mins < 60) return `${mins} min ago`;
      const hrs = Math.round(mins / 60);
      return hrs < 24 ? `${hrs} hr ago` : `${Math.round(hrs / 24)} d ago`;
    }

    function playChimeNotification() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        const now = ctx.currentTime;
        [880, 1108.73].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "sine";
          osc.frequency.value = freq;
          const startTime = now + idx * 0.12;
          gain.gain.setValueAtTime(0.0001, startTime);
          gain.gain.exponentialRampToValueAtTime(0.2, startTime + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.3);
          osc.connect(gain).connect(ctx.destination);
          osc.start(startTime);
          osc.stop(startTime + 0.32);
        });
      } catch (e) {}
    }

    // --- MAIN APP COMPONENT ---
    function App() {
      const [staff, setStaff] = useState(() => {
        try { const saved = localStorage.getItem("sc_staff"); return saved ? JSON.parse(saved) : INITIAL_STAFF; } catch(e) { return INITIAL_STAFF; }
      });
      const [cabin, setCabin] = useState(() => {
        try { const saved = localStorage.getItem("sc_cabin"); return saved ? JSON.parse(saved) : INITIAL_CABIN; } catch(e) { return INITIAL_CABIN; }
      });
      const [messages, setMessages] = useState(() => {
        try { const saved = localStorage.getItem("sc_messages"); return saved ? JSON.parse(saved) : INITIAL_MESSAGES; } catch(e) { return INITIAL_MESSAGES; }
      });
      const [notices, setNotices] = useState(() => {
        try { const saved = localStorage.getItem("sc_notices"); return saved ? JSON.parse(saved) : INITIAL_NOTICES; } catch(e) { return INITIAL_NOTICES; }
      });
      const [appointments, setAppointments] = useState(() => {
        try { const saved = localStorage.getItem("sc_appointments"); return saved ? JSON.parse(saved) : INITIAL_APPOINTMENTS; } catch(e) { return INITIAL_APPOINTMENTS; }
      });
      const [activity, setActivity] = useState(() => {
        try { const saved = localStorage.getItem("sc_activity"); return saved ? JSON.parse(saved) : INITIAL_ACTIVITY; } catch(e) { return INITIAL_ACTIVITY; }
      });
      const [currentUserId, setCurrentUserId] = useState(() => {
        try { return localStorage.getItem("sc_session_user") || null; } catch(e) { return null; }
      });

      const [activeTab, setActiveTab] = useState("messages");
      const [activeThreadId, setActiveThreadId] = useState(DEANS_HODS_GROUP_ID);
      const [showMobileSidebar, setShowMobileSidebar] = useState(false);

      useEffect(() => { try { localStorage.setItem("sc_staff", JSON.stringify(staff)); } catch(e){} }, [staff]);
      useEffect(() => { try { localStorage.setItem("sc_cabin", JSON.stringify(cabin)); } catch(e){} }, [cabin]);
      useEffect(() => { try { localStorage.setItem("sc_messages", JSON.stringify(messages)); } catch(e){} }, [messages]);
      useEffect(() => { try { localStorage.setItem("sc_notices", JSON.stringify(notices)); } catch(e){} }, [notices]);
      useEffect(() => { try { localStorage.setItem("sc_appointments", JSON.stringify(appointments)); } catch(e){} }, [appointments]);
      useEffect(() => { try { localStorage.setItem("sc_activity", JSON.stringify(activity)); } catch(e){} }, [activity]);

      const currentUser = useMemo(() => staff.find(s => s.id === currentUserId) || null, [staff, currentUserId]);

      const handleSignIn = (id, password) => {
        const found = staff.find(s => s.id === id);
        if (!found) return { ok: false, error: "Invalid post login ID selected." };
        if (found.password && found.password !== password) {
          return { ok: false, error: "Incorrect password for this post." };
        }
        setCurrentUserId(id);
        try { localStorage.setItem("sc_session_user", id); } catch(e){}
        setActiveThreadId(found.group_member ? DEANS_HODS_GROUP_ID : "principal@geca");
        return { ok: true };
      };

      const handleSignOut = () => {
        setCurrentUserId(null);
        try { localStorage.removeItem("sc_session_user"); } catch(e){}
      };

      const logActivity = (actor, action, detail) => {
        setActivity(prev => [
          { id: "act_" + Date.now(), actor, action, detail: detail || null, created_at: new Date().toISOString() },
          ...prev.slice(0, 39)
        ]);
      };

      const onlineCount = useMemo(() => Math.min(staff.length, 4), [staff.length]);

      if (!currentUser) {
        return h(SignInScreen, { staff, setStaff, onSignIn: handleSignIn });
      }

      return h('div', { className: "flex min-h-screen flex-col bg-paper" },
        h(HeaderBar, {
          me: currentUser,
          principal: staff.find(s => s.id === "principal@geca"),
          principalState: cabin["principal@geca"]?.status,
          onlineCount,
          onSignOut: handleSignOut
        }),
        h('nav', { className: "flex gap-1 overflow-x-auto border-b border-border bg-paper-2 px-2 md:px-4" },
          [
            { id: "messages", label: "Messages" },
            { id: "notices", label: "Notice Board" },
            { id: "appointments", label: "Appointments" },
            { id: "overview", label: "Campus Overview" },
            ...(currentUser.is_admin ? [{ id: "admin", label: "Roles & Access" }] : [])
          ].map(tab =>
            h('button', {
              key: tab.id,
              type: "button",
              onClick: () => setActiveTab(tab.id),
              className: `-mb-px shrink-0 border-b-2 px-3 py-2.5 text-[12.5px] font-semibold transition-colors md:px-4 md:text-[13px] ${
                activeTab === tab.id ? "border-brass text-ink font-bold" : "border-transparent text-text-soft hover:text-ink"
              }`
            }, tab.label)
          )
        ),
        h('div', { className: "flex items-center justify-between border-b border-border bg-paper px-3 py-2 md:hidden" },
          h('button', {
            type: "button",
            onClick: () => setShowMobileSidebar(prev => !prev),
            className: "rounded-sm border border-border px-3 py-1.5 text-[12.5px] font-semibold text-ink"
          }, showMobileSidebar ? "Hide directory" : "Directory & cabin lamp"),
          h('span', { className: "text-[11.5px] text-text-soft" }, `${onlineCount} online now`)
        ),
        h('div', { className: "flex min-h-0 flex-1 flex-col md:flex-row overflow-hidden" },
          h('div', { className: `${showMobileSidebar ? "flex" : "hidden"} min-h-0 flex-col md:flex` },
            h(DirectorySidebar, {
              me: currentUser, staff, cabin, messages, setCabin,
              activeId: activeTab === "messages" ? activeThreadId : null,
              onSelect: id => { setActiveThreadId(id); setActiveTab("messages"); setShowMobileSidebar(false); },
              logActivity
            })
          ),
          h('main', { className: `${showMobileSidebar ? "hidden" : "flex"} min-h-0 flex-1 flex-col md:flex` },
            activeTab === "messages" && h(MessagesView, { me: currentUser, staff, cabin, messages, setMessages, activeId: activeThreadId }),
            activeTab === "notices" && h(NoticesView, { me: currentUser, staff, notices, setNotices, logActivity }),
            activeTab === "appointments" && h(AppointmentsView, { me: currentUser, staff, cabin, appointments, setAppointments, logActivity }),
            activeTab === "overview" && h(OverviewView, { staff, cabin, messages, appointments, activity, onSelect: id => { setActiveThreadId(id); setActiveTab("messages"); } }),
            activeTab === "admin" && currentUser.is_admin && h(AdminRolesView, { staff, setStaff, logActivity })
          )
        )
      );
    }

    // --- HEADER BAR ---
    function HeaderBar({ me, principal, principalState, onlineCount, onSignOut }) {
      return h('header', { className: "flex flex-wrap items-center justify-between gap-3 border-b-[3px] border-brass bg-ink px-6 py-3 text-paper shadow-md" },
        h('div', { className: "flex items-center gap-3" },
          h('div', { className: "flex h-9 w-9 items-center justify-center rounded-full border-2 border-brass-light serif text-[15px] font-bold text-brass-light" }, "GC"),
          h('div', null,
            h('p', { className: "text-lg font-semibold tracking-wide leading-none" }, "Staff Connect"),
            h('p', { className: "text-[11px] text-paper/60 mt-0.5" }, "Government College of Engineering · Live Campus Board")
          )
        ),
        h('div', { className: "flex items-center gap-2.5 rounded-full border border-brass-light/35 bg-ink-2 px-4 py-1.5 text-[13.5px]" },
          h('span', { className: getLampClass(principalState || "out") }),
          h('span', { className: "text-paper/75" }, "Principal’s cabin:"),
          h('span', { className: "font-semibold text-paper" }, STATUS_LABELS[principalState || "out"]),
          principal && h('span', { className: "text-paper/45" }, `· ${principal.name}`)
        ),
        h('div', { className: "flex items-center gap-3 text-[13px] text-paper/70" },
          h('span', { className: "rounded-full bg-ink-2 px-3 py-1 text-[12px]" }, `${onlineCount} online now`),
          h('span', null, "Signed in as ", h('span', { className: "font-semibold text-paper" }, me.name)),
          h('button', {
            type: "button", onClick: onSignOut,
            className: "rounded-full border border-paper/35 px-3 py-1 text-[12.5px] transition-colors hover:border-brass-light hover:text-brass-light"
          }, "Sign out")
        )
      );
    }

    // --- SIGN IN SCREEN ---
    function SignInScreen({ staff, setStaff, onSignIn }) {
      const [selectedId, setSelectedId] = useState("");
      const [password, setPassword] = useState("");
      const [errorMsg, setErrorMsg] = useState("");
      const [loading, setLoading] = useState(false);
      const [isResetMode, setIsResetMode] = useState(false);

      const handleSubmit = (e) => {
        e.preventDefault();
        setLoading(true);
        setErrorMsg("");
        setTimeout(() => {
          const res = onSignIn(selectedId, password);
          if (!res.ok) setErrorMsg(res.error);
          setLoading(false);
        }, 300);
      };

      return h('main', { className: "flex min-h-screen items-center justify-center px-4 py-10 bg-paper-2" },
        h('div', { className: "flex w-full max-w-4xl flex-col overflow-hidden rounded-md shadow-plate md:flex-row bg-white border border-border" },
          h('section', { className: "relative flex min-w-[280px] flex-1 flex-col justify-between bg-ink p-7 text-paper md:p-10" },
            h('span', { className: "pointer-events-none absolute inset-2.5 border border-brass-light/25", "aria-hidden": "true" }),
            h('div', null,
              h('div', { className: "mb-7 flex h-14 w-14 items-center justify-center rounded-full border-2 border-brass-light serif text-xl font-bold text-brass-light" }, "GC"),
              h('h1', { className: "mb-2 text-[26px] font-semibold leading-tight font-serif" }, "Staff Connect", h('br'), "Campus Directory"),
              h('p', { className: "max-w-80 text-[13.5px] leading-relaxed text-paper/70" }, "One shared live registry for the Principal, Deans, Registrar, HoDs, faculty, and support staff — featuring live cabin lamps, group messaging, notice board, and meeting slot requests."),
              h('div', { className: "mt-8 flex items-center gap-2.5 text-[12.5px] text-paper/70" },
                h('span', { className: "lamp lamp-free" }), "Cabin availability lamps update instantly across campus"
              )
            ),
            h('p', { className: "mt-8 text-[11.5px] text-paper/45" }, "Government College of Engineering — Internal Campus Portal")
          ),
          h('section', { className: "min-w-[280px] flex-1 bg-paper-3 p-7 md:p-10 flex flex-col justify-center" },
            !isResetMode
              ? h('div', null,
                  h('p', { className: "text-xs text-text-soft uppercase tracking-wide font-semibold" }, "Signed access by post"),
                  h('h2', { className: "mb-6 mt-1 text-[19px] font-semibold" }, "Sign in to the registry"),
                  h('form', { onSubmit: handleSubmit },
                    h('div', { className: "mb-4" },
                      h('label', { htmlFor: "login-id", className: "mb-1.5 block text-xs text-text-soft" }, "Post login ID"),
                      h('select', {
                        id: "login-id", className: "field-input", value: selectedId, onChange: e => setSelectedId(e.target.value), required: true
                      },
                        h('option', { value: "" }, "Select your post…"),
                        staff.map(s => h('option', { key: s.id, value: s.id }, `${s.role} — ${s.name} (${s.id})`))
                      )
                    ),
                    h('div', { className: "mb-4" },
                      h('label', { htmlFor: "login-pass", className: "mb-1.5 block text-xs text-text-soft" }, "Password"),
                      h('input', {
                        id: "login-pass", type: "password", className: "field-input", placeholder: "Enter password (default: 123)",
                        value: password, onChange: e => setPassword(e.target.value), required: true
                      })
                    ),
                    errorMsg && h('p', { className: "mb-3 -mt-1 text-[13px] text-brick font-medium" }, errorMsg),
                    h('button', {
                      type: "submit", disabled: loading,
                      className: "w-full rounded-sm bg-ink py-3 text-[14.5px] font-semibold text-paper transition-colors hover:bg-ink-3 disabled:opacity-60"
                    }, loading ? "Checking post credentials…" : "Enter directory")
                  ),
                  h('button', {
                    type: "button", onClick: () => setIsResetMode(true),
                    className: "mt-4 text-[12.5px] font-semibold text-ink underline underline-offset-2 text-left block"
                  }, "Change or reset a post password"),
                  h('p', { className: "mt-3 text-[12px] leading-relaxed text-text-soft" },
