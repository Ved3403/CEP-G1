          h('div', { className: "grid gap-6 md:grid-cols-2" },
            h('section', null,
              h('h3', { className: "mb-3 text-base font-semibold" }, "Requests to you"),
              h('div', { className: "flex flex-col gap-3" },
                incoming.length === 0 ? h('p', { className: "text-sm text-text-soft" }, "No pending requests sent to you.") : incoming.map(a => h(ApptCard, { key: a.id, item: a, name: getName(a.requester), role: getRole(a.requester), isOutgoing: false, onStatus: updateStatus }))
              )
            ),
            h('section', null,
              h('h3', { className: "mb-3 text-base font-semibold" }, "Your sent requests"),
              h('div', { className: "flex flex-col gap-3" },
                outgoing.length === 0 ? h('p', { className: "text-sm text-text-soft" }, "You haven’t requested any meeting slots.") : outgoing.map(a => h(ApptCard, { key: a.id, item: a, name: getName(a.target), role: getRole(a.target), isOutgoing: true, onStatus: updateStatus }))
              )
            )
          ),
          h('aside', { className: "h-fit rounded-md border border-border bg-paper-3 p-4 shadow-sm" },
            h('h3', { className: "mb-3 text-base font-semibold" }, "Request a meeting slot"),
            h('select', { value: targetId, onChange: e => setTargetId(e.target.value), className: "field-input mb-2 text-[13px]" },
              h('option', { value: "" }, "Select a staff post…"),
              staff.filter(s => s.id !== me.id).map(s => h('option', { key: s.id, value: s.id }, `${s.name} — ${s.role}`))
            ),
            targetId && h('p', { className: "mb-2 flex items-center gap-2 text-[11.5px] text-text-soft" },
              h('span', { className: getLampClass(cabin[targetId]?.status || "out") }),
              "Cabin right now: ", h('span', { className: "font-semibold text-ink" }, STATUS_LABELS[cabin[targetId]?.status || "out"])
            ),
            h('input', { value: slot, onChange: e => setSlot(e.target.value), placeholder: "Preferred slot (e.g. Tomorrow 11:30 AM)", className: "field-input mb-2 text-[13px]" }),
            h('textarea', { value: purpose, onChange: e => setPurpose(e.target.value), placeholder: "Purpose of the meeting…", className: "field-input mb-3 min-h-20 resize-none text-[13px]" }),
            h('button', { type: "button", onClick: handleSendRequest, className: "w-full rounded-sm bg-ink py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-ink-3 shadow-sm" }, "Send slot request")
          )
        )
      );
    }

    function ApptCard({ item, name, role, isOutgoing, onStatus }) {
      const statusBadges = {
        pending: "bg-amber-100 text-amber-900 border border-amber-300",
        accepted: "bg-emerald-100 text-emerald-900 border border-emerald-300",
        declined: "bg-rose-100 text-rose-900 border border-rose-300",
        cancelled: "bg-gray-100 text-gray-700 border border-gray-300"
      };

      return h('article', { className: "animate-rise rounded-md border border-border bg-white p-3.5 shadow-sm" },
        h('div', { className: "mb-1.5 flex items-center justify-between gap-2" },
          h('p', { className: "text-sm font-semibold" }, isOutgoing ? `To ${name}` : `From ${name}`),
          h('span', { className: `rounded-full px-2.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide ${statusBadges[item.status]}` }, item.status)
        ),
        h('p', { className: "text-[11.5px] text-text-soft" }, `${role} · requested ${formatTimeAgo(item.created_at)}`),
        h('p', { className: "mt-2 text-sm text-ink" }, item.purpose),
        h('p', { className: "mt-1 text-[12.5px] font-semibold text-sage-dark" }, `Slot: ${item.slot}`),
        !isOutgoing && item.status === "pending" && h('div', { className: "mt-3 flex gap-2" },
          h('button', { type: "button", onClick: () => onStatus(item.id, "accepted", item.purpose), className: "rounded-sm bg-sage-dark px-3 py-1.5 text-xs font-semibold text-paper-3 hover:bg-sage" }, "Accept"),
          h('button', { type: "button", onClick: () => onStatus(item.id, "declined", item.purpose), className: "rounded-sm border border-brick px-3 py-1.5 text-xs font-semibold text-brick hover:bg-rose-50" }, "Decline")
        ),
        isOutgoing && item.status === "pending" && h('button', { type: "button", onClick: () => onStatus(item.id, "cancelled", item.purpose), className: "mt-3 text-[11.5px] font-semibold text-brick underline" }, "Withdraw request")
      );
    }

    // --- OVERVIEW VIEW ---
    function OverviewView({ staff, cabin, messages, appointments, activity, onSelect }) {
      const freeCount = staff.filter(s => cabin[s.id]?.status === "free").length;
      const busyCount = staff.filter(s => cabin[s.id]?.status === "busy").length;
      const pendingCount = appointments.filter(a => a.status === "pending").length;
      const urgentCount = messages.filter(m => m.urgent).length;

      const stats = [
        { label: "Free in cabin", val: freeCount },
        { label: "In cabin, busy", val: busyCount },
        { label: "Online campus users", val: Math.min(staff.length, 4) },
        { label: "Pending slot requests", val: pendingCount },
        { label: "Urgent messages logged", val: urgentCount },
        { label: "Staff posts registered", val: staff.length }
      ];

      const getActorName = (id) => staff.find(s => s.id === id)?.name || id;

      return h('div', { className: "min-h-0 flex-1 overflow-y-auto p-6 bg-paper" },
        h('div', { className: "mx-auto max-w-5xl" },
          h('div', { className: "mb-6 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6" },
            stats.map(s =>
              h('div', { key: s.label, className: "rounded-md border border-border bg-white p-3.5 shadow-sm" },
                h('p', { className: "serif text-3xl font-bold text-ink" }, s.val),
                h('p', { className: "mt-1 text-[11.5px] leading-snug text-text-soft" }, s.label)
              )
            )
          ),
          h('div', { className: "grid gap-6 lg:grid-cols-[1fr_300px]" },
            h('section', null,
              h('h3', { className: "mb-3 text-base font-semibold" }, "Campus Cabin Board"),
              SECTIONS.map(sec => {
                const items = staff.filter(s => s.grp === sec);
                if (!items.length) return null;
                return h('div', { key: sec, className: "mb-5" },
                  h('p', { className: "mb-2 flex items-center gap-2 text-[11.5px] font-semibold text-text-soft uppercase tracking-wider" },
                    h('span', null, GROUP_LABELS[sec]),
                    h('span', { className: "h-px flex-1 bg-border" })
                  ),
                  h('div', { className: "grid gap-2 sm:grid-cols-2" },
                    items.map(s => {
                      const sCabin = cabin[s.id];
                      const status = sCabin?.status || "out";
                      return h('button', {
                        key: s.id, type: "button", onClick: () => onSelect(s.id),
                        className: "flex items-center gap-2.5 rounded-md border border-border bg-white p-2.5 text-left transition-colors hover:border-brass shadow-sm"
                      },
                        h('span', { className: `flex h-9 w-9 shrink-0 items-center justify-center rounded-full serif text-xs font-semibold ${getGroupBadgeBg(s.grp)}` }, getInitials(s.name)),
                        h('span', { className: "min-w-0 flex-1" },
                          h('span', { className: "block truncate text-[13px] font-semibold" }, s.name),
                          h('span', { className: "block truncate text-[11px] text-text-soft" },
                            `${s.role}${sCabin?.note ? ` · ${sCabin.note}` : ""}${sCabin?.back_at ? ` · back ${sCabin.back_at}` : ""}`
                          )
                        ),
                        h('span', { className: "flex shrink-0 items-center gap-1.5 text-[11px] font-medium text-text-soft" },
                          h('span', { className: getLampClass(status) }),
                          STATUS_LABELS[status]
                        )
                      );
                    })
                  )
                );
              })
            ),
            h('aside', null,
              h('h3', { className: "mb-3 text-base font-semibold" }, "Recent campus activity"),
              h('div', { className: "flex flex-col gap-2" },
                activity.length === 0 ? h('p', { className: "text-sm text-text-soft" }, "No activity logged yet.") : activity.slice(0, 15).map(act =>
                  h('div', { key: act.id, className: "rounded-md border border-border bg-white p-2.5 shadow-sm text-xs" },
                    h('p', { className: "text-[12.5px]" },
                      h('span', { className: "font-semibold text-ink" }, getActorName(act.actor)), " ", h('span', { className: "text-text-soft" }, act.action)
                    ),
                    act.detail && h('p', { className: "text-[11.5px] font-medium text-sage-dark" }, act.detail),
                    h('p', { className: "mt-0.5 text-[10.5px] text-text-soft" }, formatTimeAgo(act.created_at))
                  )
                )
              )
            )
          )
        )
      );
    }

    // --- ADMIN ROLES VIEW ---
    function AdminRolesView({ staff, setStaff, logActivity }) {
      const [editingRole, setEditingRole] = useState(null);
      const [isNew, setIsNew] = useState(true);

      const emptyRole = {
        id: "", name: "", role: "", dept: "", grp: "department", cabin: true, group_member: false, is_admin: false, password: "123"
      };

      const handleSave = (e) => {
        e.preventDefault();
        if (!editingRole.id || !editingRole.name || !editingRole.role) return;

        if (isNew) {
          if (staff.some(s => s.id === editingRole.id)) { alert("Login ID already exists!"); return; }
          setStaff(prev => [...prev, editingRole]);
          logActivity("admin", "created role", editingRole.id);
        } else {
          setStaff(prev => prev.map(s => s.id === editingRole.id ? editingRole : s));
          logActivity("admin", "updated role", editingRole.id);
        }
        setEditingRole(null);
      };

      const handleDelete = (id) => {
        if (window.confirm(`Delete role ${id}? The post will no longer be able to sign in.`)) {
          setStaff(prev => prev.filter(s => s.id !== id));
          logActivity("admin", "deleted role", id);
        }
      };

      return h('div', { className: "min-h-0 flex-1 overflow-y-auto p-4 md:p-6 bg-paper" },
        h('div', { className: "mb-4 flex flex-wrap items-center justify-between gap-3" },
          h('div', null,
            h('h2', { className: "text-[17px] font-semibold" }, "Roles & Access Management"),
            h('p', { className: "text-[12.5px] text-text-soft" }, "Add, edit, or remove faculty & staff posts and configure credentials live.")
          ),
          h('button', {
            type: "button", onClick: () => { setEditingRole({ ...emptyRole }); setIsNew(true); },
            className: "rounded-sm bg-ink px-4 py-2 text-[13px] font-semibold text-paper hover:bg-ink-3 shadow-sm"
          }, "Add a new role")
        ),
        editingRole && h('form', { onSubmit: handleSave, className: "mb-6 grid gap-3 rounded-md border border-border bg-paper-2 p-4 md:grid-cols-2 shadow-sm" },
          h(FormGroup, { label: "Login ID (e.g. hodit@geca)" },
            h('input', { className: "field-input", value: editingRole.id, disabled: !isNew, onChange: e => setEditingRole({ ...editingRole, id: e.target.value }), required: true })
          ),
          h(FormGroup, { label: "Full Name" },
            h('input', { className: "field-input", value: editingRole.name, onChange: e => setEditingRole({ ...editingRole, name: e.target.value }), required: true })
          ),
          h(FormGroup, { label: "Post Title" },
            h('input', { className: "field-input", value: editingRole.role, onChange: e => setEditingRole({ ...editingRole, role: e.target.value }), required: true })
          ),
          h(FormGroup, { label: "Department / Office" },
            h('input', { className: "field-input", value: editingRole.dept, onChange: e => setEditingRole({ ...editingRole, dept: e.target.value }) })
          ),
          h(FormGroup, { label: "Section Group" },
            h('select', { className: "field-input", value: editingRole.grp, onChange: e => setEditingRole({ ...editingRole, grp: e.target.value }) },
              SECTIONS.map(s => h('option', { key: s, value: s }, GROUP_LABELS[s]))
            )
          ),
          h(FormGroup, { label: "Password" },
            h('input', { type: "password", className: "field-input", value: editingRole.password || "", onChange: e => setEditingRole({ ...editingRole, password: e.target.value }), placeholder: "Set login password" })
          ),
          h('div', { className: "flex flex-wrap items-center gap-4 md:col-span-2 pt-2" },
            h(FormCheckbox, { label: "Has a physical cabin", checked: editingRole.cabin, onChange: v => setEditingRole({ ...editingRole, cabin: v }) }),
            h(FormCheckbox, { label: "Member of Deans & HoDs group chat", checked: editingRole.group_member, onChange: v => setEditingRole({ ...editingRole, group_member: v }) }),
            h(FormCheckbox, { label: "Can manage roles (Admin privileges)", checked: editingRole.is_admin, onChange: v => setEditingRole({ ...editingRole, is_admin: v }) })
          ),
          h('div', { className: "flex gap-2 md:col-span-2 mt-2" },
            h('button', { type: "submit", className: "rounded-sm bg-ink px-4 py-2 text-[13px] font-semibold text-paper hover:bg-ink-3 shadow-sm" }, "Save post role"),
            h('button', { type: "button", onClick: () => setEditingRole(null), className: "rounded-sm border border-border px-4 py-2 text-[13px] font-semibold text-ink" }, "Cancel")
          )
        ),
        h('div', { className: "overflow-x-auto rounded-md border border-border bg-white shadow-sm" },
          h('table', { className: "w-full min-w-[640px] text-left text-[13px]" },
            h('thead', { className: "bg-paper-2 text-[12px] uppercase tracking-wide text-text-soft border-b border-border" },
              h('tr', null,
                h('th', { className: "px-3.5 py-2.5" }, "Login ID"),
                h('th', { className: "px-3.5 py-2.5" }, "Name"),
                h('th', { className: "px-3.5 py-2.5" }, "Post Title"),
                h('th', { className: "px-3.5 py-2.5" }, "Section"),
                h('th', { className: "px-3.5 py-2.5 text-right" }, "Actions")
              )
            ),
            h('tbody', null,
              staff.map(s =>
                h('tr', { key: s.id, className: "border-t border-border hover:bg-paper-2/50 transition-colors" },
                  h('td', { className: "px-3.5 py-2.5 font-medium text-ink" },
                    s.id, s.is_admin && h('span', { className: "ml-2 rounded-full bg-brass/20 px-2 py-0.5 text-[10px] font-bold text-brass uppercase" }, "Admin")
                  ),
                  h('td', { className: "px-3.5 py-2.5" }, s.name),
                  h('td', { className: "px-3.5 py-2.5" }, s.role),
                  h('td', { className: "px-3.5 py-2.5 text-text-soft" }, GROUP_LABELS[s.grp] || s.grp),
                  h('td', { className: "whitespace-nowrap px-3.5 py-2.5 text-right" },
                    h('button', { type: "button", onClick: () => { setEditingRole({ ...s }); setIsNew(false); }, className: "mr-3 font-semibold text-ink underline underline-offset-2" }, "Edit"),
                    h('button', { type: "button", onClick: () => handleDelete(s.id), className: "font-semibold text-brick underline underline-offset-2" }, "Delete")
                  )
                )
              )
            )
          )
        )
      );
    }

    function FormGroup({ label, children }) {
      return h('label', { className: "block" },
        h('span', { className: "mb-1 block text-xs font-semibold text-text-soft" }, label),
        children
      );
    }

    function FormCheckbox({ label, checked, onChange }) {
      return h('label', { className: "flex items-center gap-2 text-[13px] cursor-pointer select-none" },
        h('input', { type: "checkbox", checked, onChange: e => onChange(e.target.checked), className: "accent-brass" }),
        label
      );
    }

    // Render App
    const rootElement = document.getElementById("root");
    ReactDOM.createRoot(rootElement).render(h(App));
  </script>
</body>
</html>
