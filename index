              activeId === DEANS_HODS_GROUP_ID ? "border-brass bg-paper-3 font-semibold" : "border-transparent hover:bg-paper-3/50"
            }`
          },
            h('span', { className: `flex h-9 w-9 items-center justify-center rounded-full serif text-[12.5px] font-semibold ${getGroupBadgeBg("group")}` }, "DH"),
            h('span', { className: "min-w-0 flex-1" },
              h('span', { className: "block text-[13.5px] font-semibold leading-tight" }, GROUP_TITLE),
              h('span', { className: "block text-[11px] text-text-soft" }, "Principal · Deans · Registrar · HoDs")
            ),
