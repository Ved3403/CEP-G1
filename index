          h('p', { className: "mb-2.5 text-[11.5px] leading-snug text-paper/70" }, "Your cabin lamp — updates live across campus directory."),
          h('div', { className: "flex flex-col gap-1.5" },
            ["free", "busy", "out"].map(st =>
