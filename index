    };

    const SECTIONS = ["leadership", "department", "support"];
    const NOTICE_CATEGORIES = ["General", "Meeting", "Examinations", "Events", "Maintenance", "Academics"];

    const STATUS_LABELS = {
      free: "Free",
      busy: "Busy",
