    // --- APPOINTMENTS VIEW ---
    function AppointmentsView({ me, staff, cabin, appointments, setAppointments, logActivity }) {
      const [targetId, setTargetId] = useState("");
      const [slot, setSlot] = useState("");
      const [purpose, setPurpose] = useState("");

      const handleSendRequest = () => {
        if (!targetId || !slot.trim() || !purpose.trim()) return;
        const newAppt = {
          id: "a_" + Date.now(), requester: me.id, target: targetId, purpose: purpose.trim(), slot: slot.trim(), status: "pending", created_at: new Date().toISOString()
        };
        setAppointments(prev => [newAppt, ...prev]);
        logActivity(me.id, "requested a meeting", purpose.trim());
        setSlot(""); setPurpose("");
      };

      const updateStatus = (id, newStatus, purp) => {
        setAppointments(prev => prev.map(a => a.id === id ? { ...a, status: newStatus } : a));
        logActivity(me.id, `${newStatus} a meeting request`, purp);
      };

      const incoming = appointments.filter(a => a.target === me.id);
      const outgoing = appointments.filter(a => a.requester === me.id);

      const getName = (id) => staff.find(s => s.id === id)?.name || id;
      const getRole = (id) => staff.find(s => s.id === id)?.role || "";

      return h('div', { className: "min-h-0 flex-1 overflow-y-auto p-6 bg-paper" },
