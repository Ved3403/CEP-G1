    // --- MESSAGES VIEW ---
    function MessagesView({ me, staff, cabin, messages, setMessages, activeId }) {
      const [inputBody, setInputBody] = useState("");
      const [isUrgent, setIsUrgent] = useState(false);
      const [filterTerm, setFilterTerm] = useState("");
      const scrollRef = useRef(null);

      const isGroup = activeId === DEANS_HODS_GROUP_ID;
      const targetUser = staff.find(s => s.id === activeId);

      const threadMessages = useMemo(() => {
        if (!activeId) return [];
        let filtered = isGroup
          ? messages.filter(m => m.recipient === DEANS_HODS_GROUP_ID)
          : messages.filter(m => (m.sender === me.id && m.recipient === activeId) || (m.sender === activeId && m.recipient === me.id));
        if (filterTerm.trim()) {
          const ft = filterTerm.toLowerCase().trim();
          filtered = filtered.filter(m => m.body.toLowerCase().includes(ft));
        }
        return filtered;
      }, [messages, activeId, isGroup, me.id, filterTerm]);

      useEffect(() => {
        if (!activeId) return;
        const unreadIds = messages
          .filter(m => !m.read_at && m.sender !== me.id && (isGroup ? m.recipient === DEANS_HODS_GROUP_ID : m.sender === activeId && m.recipient === me.id))
          .map(m => m.id);

        if (unreadIds.length > 0) {
          setMessages(prev => prev.map(m => (unreadIds.includes(m.id) ? { ...m, read_at: new Date().toISOString() } : m)));
        }
      }, [activeId, isGroup, me.id]);

      useEffect(() => {
        if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
      }, [threadMessages.length, activeId]);

      const handleSendMessage = () => {
        const body = inputBody.trim();
        if (!body || !activeId) return;
        const newMsg = {
          id: "m_" + Date.now(),
          sender: me.id,
          recipient: activeId,
          body,
          urgent: isUrgent,
          created_at: new Date().toISOString(),
          read_at: null
        };
        setMessages(prev => [...prev, newMsg]);
        setInputBody("");
        setIsUrgent(false);
        playChimeNotification();
      };

      if (!activeId) {
        return h('div', { className: "flex flex-1 items-center justify-center p-10 text-center text-sm text-text-soft" }, "Select a post from the directory to open its chat thread.");
      }

      const targetCabin = targetUser ? cabin[targetUser.id] : null;

      return h('div', { className: "flex min-h-0 flex-1 flex-col h-full bg-paper" },
        h('div', { className: "flex flex-wrap items-center gap-3 border-b border-border bg-paper-3 px-6 py-3.5 shadow-sm" },
          h('span', { className: `flex h-10 w-10 items-center justify-center rounded-full serif text-sm font-semibold ${getGroupBadgeBg(isGroup ? "group" : targetUser?.grp)}` },
            isGroup ? "DH" : getInitials(targetUser?.name)
          ),
          h('div', { className: "min-w-0 flex-1" },
            h('p', { className: "text-base font-semibold" }, isGroup ? GROUP_TITLE : targetUser?.name),
            h('p', { className: "flex items-center gap-2 text-xs text-text-soft" },
              isGroup ? "Standing Thread · Principal, Deans, Registrar & HoDs" : `${targetUser?.role} · ${targetUser?.dept}`
            )
          ),
          h('input', {
            type: "search", value: filterTerm, onChange: e => setFilterTerm(e.target.value), placeholder: "Search in thread…", className: "field-input w-44 text-[12.5px]"
          })
        ),
        h('div', { ref: scrollRef, className: "flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-6" },
          threadMessages.length === 0
            ? h('p', { className: "m-auto max-w-xs text-center text-sm text-text-soft" }, "No messages here yet. Send the first message.")
            : threadMessages.map((msg, idx) => {
                const isMine = msg.sender === me.id;
                const senderStaff = staff.find(s => s.id === msg.sender);
                const prevMsg = threadMessages[idx - 1];
                const showDate = !prevMsg || formatDateLabel(msg.created_at) !== formatDateLabel(prevMsg.created_at);

                return h('div', { key: msg.id, className: "flex flex-col" },
                  showDate && h('p', { className: "my-2 self-center rounded-full bg-paper-2 px-3 py-1 text-[11px] font-medium text-text-soft border border-border" }, formatDateLabel(msg.created_at)),
                  h('div', {
                    className: `max-w-[70%] animate-rise rounded-md px-3.5 py-2.5 text-sm leading-snug shadow-sm ${
                      isMine ? "self-end rounded-br-sm bg-sage-dark text-paper-3" : "self-start rounded-bl-sm border border-border bg-white text-ink"
                    } ${msg.urgent ? "border-l-4 border-l-brick" : ""}`
                  },
                    isGroup && !isMine && h('span', { className: "mb-1 block text-[11px] font-semibold text-sage-dark" }, `${senderStaff?.name} · ${senderStaff?.role}`),
                    msg.urgent && h('span', { className: "mb-1.5 inline-block rounded-full bg-brick px-2 py-0.5 text-[10px] font-bold tracking-wide text-white uppercase" }, "URGENT"),
                    h('p', { className: "whitespace-pre-wrap" }, msg.body),
                    h('p', { className: `mt-1.5 text-[10.5px] ${isMine ? "text-paper-3/75" : "text-text-soft"}` },
                      formatTime(msg.created_at), isMine && (msg.read_at ? " · read" : " · sent")
                    )
                  )
                );
              })
        ),
        h('div', { className: "flex items-end gap-2.5 border-t border-border bg-paper-3 px-5 py-3.5" },
          h('textarea', {
            value: inputBody, onChange: e => setInputBody(e.target.value),
            onKeyDown: e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); handleSendMessage(); } },
            placeholder: "Write a message to thread… (Press Enter to send)", className: "field-input max-h-28 min-h-11 flex-1 resize-none"
          }),
          h('label', { className: "flex cursor-pointer select-none items-center gap-1.5 whitespace-nowrap pb-3 text-xs text-text-soft" },
            h('input', { type: "checkbox", checked: isUrgent, onChange: e => setIsUrgent(e.target.checked), className: "accent-brick" }),
            "Mark urgent"
          ),
          h('button', { type: "button", onClick: handleSendMessage, className: "rounded-md bg-sage-dark px-5 py-2.5 text-[13.5px] font-semibold text-paper-3 transition-colors hover:bg-sage shadow-sm" }, "Send")
        )
      );
    }

    // --- NOTICES VIEW ---
    function NoticesView({ me, staff, notices, setNotices, logActivity }) {
      const [title, setTitle] = useState("");
      const [body, setBody] = useState("");
      const [category, setCategory] = useState("General");
      const [isUrgent, setIsUrgent] = useState(false);
      const [activeCategory, setActiveCategory] = useState("All");

      const handlePublish = () => {
        if (!title.trim() || !body.trim()) return;
        const newNotice = {
          id: "n_" + Date.now(), author: me.id, title: title.trim(), body: body.trim(),
          category, urgent: isUrgent, pinned: false, created_at: new Date().toISOString()
        };
        setNotices(prev => [newNotice, ...prev]);
        logActivity(me.id, "posted a notice", title.trim());
        setTitle(""); setBody(""); setIsUrgent(false);
      };

      const togglePin = (n) => setNotices(prev => prev.map(item => item.id === n.id ? { ...item, pinned: !item.pinned } : item));
      const handleDelete = (id) => setNotices(prev => prev.filter(item => item.id !== id));

      const filteredNotices = notices.filter(n => activeCategory === "All" || n.category === activeCategory).sort((a, b) => Number(b.pinned) - Number(a.pinned));

      return h('div', { className: "min-h-0 flex-1 overflow-y-auto p-6 bg-paper" },
        h('div', { className: "mx-auto grid max-w-5xl gap-6 lg:grid-cols-[1fr_320px]" },
          h('section', null,
            h('div', { className: "mb-4 flex flex-wrap items-center gap-2" },
              ["All", ...NOTICE_CATEGORIES].map(cat =>
                h('button', {
                  key: cat, type: "button", onClick: () => setActiveCategory(cat),
                  className: `rounded-full px-3 py-1 text-xs font-semibold transition-colors ${activeCategory === cat ? "bg-ink text-paper" : "border border-border bg-white text-text-soft hover:border-brass"}`
                }, cat)
              )
            ),
            h('div', { className: "flex flex-col gap-3.5" },
              filteredNotices.length === 0
                ? h('p', { className: "text-sm text-text-soft" }, "No notices published in this category yet.")
                : filteredNotices.map(n => {
                    const author = staff.find(s => s.id === n.author);
                    return h('article', { key: n.id, className: `animate-rise rounded-md border bg-white p-4 shadow-sm ${n.urgent ? "border-l-4 border-l-brick border-border" : "border-border"}` },
                      h('div', { className: "mb-2 flex items-start gap-3" },
                        h('span', { className: `flex h-9 w-9 shrink-0 items-center justify-center rounded-full serif text-xs font-semibold ${getGroupBadgeBg(author?.grp)}` }, getInitials(author?.name)),
                        h('div', { className: "min-w-0 flex-1" },
                          h('h3', { className: "text-base font-semibold leading-snug" }, n.pinned && h('span', { className: "mr-1 text-brass font-bold" }, "★ [PINNED] "), n.title),
                          h('p', { className: "text-[11.5px] text-text-soft" }, `${author?.name} · ${author?.role} · ${formatTimeAgo(n.created_at)}`)
                        ),
                        h('span', { className: "rounded-full bg-paper-2 px-2.5 py-1 text-[10.5px] font-semibold text-text-soft border border-border" }, n.category)
                      ),
                      h('p', { className: "whitespace-pre-wrap text-sm leading-relaxed text-ink" }, n.body),
                      h('div', { className: "mt-3 flex gap-3 text-[11.5px]" },
                        h('button', { type: "button", onClick: () => togglePin(n), className: "font-semibold text-sage-dark underline" }, n.pinned ? "Unpin notice" : "Pin to top"),
                        n.author === me.id && h('button', { type: "button", onClick: () => handleDelete(n.id), className: "font-semibold text-brick underline" }, "Withdraw notice")
                      )
                    );
                  })
            )
          ),
          h('aside', { className: "h-fit rounded-md border border-border bg-paper-3 p-4 shadow-sm" },
            h('h3', { className: "mb-3 text-base font-semibold" }, "Post a campus notice"),
            h('input', { value: title, onChange: e => setTitle(e.target.value), placeholder: "Notice heading", className: "field-input mb-2 text-[13px]" }),
            h('textarea', { value: body, onChange: e => setBody(e.target.value), placeholder: "Details for all staff members…", className: "field-input mb-2 min-h-24 resize-none text-[13px]" }),
            h('select', { value: category, onChange: e => setCategory(e.target.value), className: "field-input mb-2 text-[13px]" },
              NOTICE_CATEGORIES.map(c => h('option', { key: c, value: c }, c))
            ),
            h('label', { className: "mb-3 flex cursor-pointer items-center gap-2 text-xs text-text-soft" },
              h('input', { type: "checkbox", checked: isUrgent, onChange: e => setIsUrgent(e.target.checked), className: "accent-brick" }),
              "Flag as urgent"
            ),
            h('button', { type: "button", onClick: handlePublish, className: "w-full rounded-sm bg-ink py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-ink-3 shadow-sm" }, "Publish to board")
