        SECTIONS.map(sec => {
          const items = staff.filter(s => s.grp === sec && s.id !== me.id && filterStaff(s));
          if (!items.length) return null;
          return h('div', { key: sec },
            h(SectionHeader, { title: GROUP_LABELS[sec] }),
