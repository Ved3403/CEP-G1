    // --- PASSWORD RESET FORM ---
    function PasswordResetForm({ staff, setStaff, onDone }) {
      const [id, setId] = useState("");
      const [curPass, setCurPass] = useState("");
      const [newPass, setNewPass] = useState("");
      const [status, setStatus] = useState(null);

      const handleReset = (e) => {
        e.preventDefault();
        const found = staff.find(s => s.id === id);
        if (!found) { setStatus({ kind: "err", text: "Post ID not found." }); return; }
        if (found.password && found.password !== curPass) { setStatus({ kind: "err", text: "Current password does not match." }); return; }
        setStaff(prev => prev.map(s => s.id === id ? { ...s, password: newPass } : s));
        setStatus({ kind: "ok", text: "Password updated successfully. You may sign in now." });
      };

      return h('div', null,
        h('p', { className: "text-xs text-text-soft uppercase tracking-wide font-semibold" }, "Password Reset"),
        h('h2', { className: "mb-5 mt-1 text-[19px] font-semibold" }, "Set a new password"),
        h('form', { onSubmit: handleReset },
          h('div', { className: "mb-3" },
            h('label', { className: "mb-1.5 block text-xs text-text-soft" }, "Post login ID"),
            h('input', { className: "field-input", placeholder: "e.g. principal@geca", value: id, onChange: e => setId(e.target.value), required: true })
          ),
          h('div', { className: "mb-3" },
            h('label', { className: "mb-1.5 block text-xs text-text-soft" }, "Current password"),
            h('input', { type: "password", className: "field-input", value: curPass, onChange: e => setCurPass(e.target.value), required: true })
          ),
          h('div', { className: "mb-4" },
            h('label', { className: "mb-1.5 block text-xs text-text-soft" }, "New password"),
            h('input', { type: "password", className: "field-input", value: newPass, onChange: e => setNewPass(e.target.value), required: true })
          ),
          status && h('p', { className: `mb-3 text-[13px] ${status.kind === "ok" ? "text-sage-dark font-medium" : "text-brick"}` }, status.text),
          h('button', { type: "submit", className: "w-full rounded-sm bg-ink py-3 text-[14.5px] font-semibold text-paper transition-colors hover:bg-ink-3" }, "Update password")
        ),
        h('button', { type: "button", onClick: onDone, className: "mt-4 text-[12.5px] font-semibold text-ink underline underline-offset-2 block" }, "Back to sign in")
      );
    }

