  <!-- React 18 Production UMD (GitHub Pages Compatible) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js" crossorigin="anonymous"></script>

  <style>
    @keyframes lamp-pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.12); opacity: 0.85; }
    }
    .lamp {
      width: 12px;
      height: 12px;
      border-radius: 9999px;
      display: inline-block;
      flex-shrink: 0;
      box-shadow: inset 0 0 0 2px rgba(0,0,0,0.15);
    }
    .lamp-free {
      background-color: #10b981;
      box-shadow: 0 0 10px 2px rgba(16, 185, 129, 0.6);
      animation: lamp-pulse 2.6s ease-in-out infinite;
    }
    .lamp-busy {
      background-color: #f59e0b;
      box-shadow: 0 0 10px 2px rgba(245, 158, 11, 0.6);
    }
    .lamp-out {
      background-color: #6b7280;
    }
    .field-input {
      border-radius: 4px;
      border: 1px solid #dfdcd3;
      width: 100%;
      color: #1a1917;
      font-size: 0.875rem;
      font-family: Inter, sans-serif;
      background: #ffffff;
      padding: 0.6rem 0.75rem;
      outline: none;
      transition: border-color 0.15s ease;
    }
    .field-input:focus {
      border-color: #9c7a42;
      box-shadow: 0 0 0 2px rgba(156, 122, 66, 0.2);
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-rise {
      animation: rise 0.25s ease-out forwards;
    }
  </style>
</head>
<body class="bg-paper text-ink font-sans antialiased min-h-screen">
  <div id="root"></div>

  <script>
    // Pure React Element Helper (No Babel required = 100% GitHub Pages compatible!)
    const h = (type, props, ...children) => React.createElement(type, props, ...children.flat(Infinity).filter(c => c !== null && c !== undefined && c !== false));
    const { useState, useEffect, useRef, useMemo } = React;

    // --- INITIAL DATA & CONSTANTS ---
    const DEANS_HODS_GROUP_ID = "grp-deanshods";
