                  activeId === s.id ? "border-brass bg-brass/15" : "border-transparent hover:bg-brass/10"
                }`
              },
                h('span', { className: "relative" },
                  h('span', { className: `flex h-9 w-9 items-center justify-center rounded-full serif text-[12.5px] font-semibold ${getGroupBadgeBg(s.grp)}` }, getInitials(s.name)),
                  h('span', { className: "absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border-2 border-paper-2 bg-emerald-500" })
